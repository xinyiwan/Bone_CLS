# ---------------------------------------------------------------------------
# Shape probe: does MedGemma see the red overlay at all?  (chance = 25%)
# Same container as the main pilot; see README.md for the rationale.
# ---------------------------------------------------------------------------

docker run --rm -it --gpus 6  \
  -v /home/ext_xinwan/Bone_AI/Bone_CLS/working/vision_model:/working   \
  -v /mnt/tmp_storage/Bone_AI/tmp_sorted_data:/data    \
  -v /home/ext_xinwan/Bone_AI/output/vision_model:/results    \
  -w /working  --entrypoint bash   \
  medgemma-hf


# --- 1. build pseudo-segmentation images (CPU only) ------------------------
    # main condition: geometric shape over the real lesion crop
    python shape_probe/build_shapes.py \
        --metadata /results/preprocess/overlay_128/metadata.csv \
        --out-root /results/shape_probe/mri --background mri

    # controls
    python shape_probe/build_shapes.py \
        --metadata /results/preprocess/overlay_128/metadata.csv \
        --out-root /results/shape_probe/blank --background blank
    python shape_probe/build_shapes.py \
        --metadata /results/preprocess/overlay_128/metadata.csv \
        --out-root /results/shape_probe/noise --background noise

    # easier variants, if the model is at chance everywhere
    python shape_probe/build_shapes.py \
        --metadata /results/preprocess/overlay_128/metadata.csv \
        --out-root /results/shape_probe/mri_big --background mri --shape-scale 1.5
    python shape_probe/build_shapes.py \
        --metadata /results/preprocess/overlay_128/metadata.csv \
        --out-root /results/shape_probe/mri_filled --background mri --filled


# --- 1b. clinical set: 3 margin classes ------------------------------------
    # --skip-shapes defaults to geographic,exophytic (see build_shapes.py --help),
    # so this builds round_oval / lobulated / irregular -- chance 33%.
    python shape_probe/build_shapes.py \
        --metadata /results/preprocess/overlay_128/metadata.csv \
        --out-root /results/shape_probe/clinical --background mri \
        --shape-set clinical --difficulty 1.0,0.6,0.35

    # the easy build the few-shot exemplars come from
    python shape_probe/build_shapes.py \
        --metadata /results/preprocess/overlay_128/metadata.csv \
        --out-root /results/shape_probe/clinical_easy --background mri \
        --shape-set clinical --difficulty easy

    # all five, if you want the old behaviour back
    python shape_probe/build_shapes.py \
        --metadata /results/preprocess/overlay_128/metadata.csv \
        --out-root /results/shape_probe/clinical_all5 --background mri \
        --shape-set clinical --skip-shapes ''


# --- 2. QC the images BEFORE spending GPU time ----------------------------
    python shape_probe/preview.py \
        --metadata /results/shape_probe/mri/shape_metadata.csv \
        --out /results/shape_probe/mri/preview.png --n 24

    # and the few-shot exemplars specifically (no GPU)
    python shape_probe/run_shape_probe.py --mode exemplars --num-few-shot 1 \
        --few-shot-metadata /results/shape_probe/clinical_easy/shape_metadata.csv \
        --exemplar-sheet /results/shape_probe/clinical_easy/exemplars.png


# --- 3. infer (resume-safe; re-run the same line to continue) -------------
    # quick read first
    python shape_probe/run_shape_probe.py --mode infer --limit 40 \
        --model-id /models/medgemma-1.5-4b-it \
        --metadata /results/shape_probe/mri/shape_metadata.csv \
        --out /results/shape_probe/mri/probe_results.csv

    # full run (same --out: picks up where the --limit run stopped)
    python shape_probe/run_shape_probe.py --mode infer \
        --model-id /models/medgemma-1.5-4b-it \
        --metadata /results/shape_probe/mri/shape_metadata.csv \
        --out /results/shape_probe/mri/probe_results.csv

    python shape_probe/run_shape_probe.py --mode infer \
        --model-id /models/medgemma-1.5-4b-it \
        --metadata /results/shape_probe/blank/shape_metadata.csv \
        --out /results/shape_probe/blank/probe_results.csv


# --- 3b. few-shot (esp. the clinical set: 1 = one example per margin class) --
    # exemplars from a separate easy build -> nothing held out, so this scores
    # the same images as the zero-shot run above and the two are comparable
    python shape_probe/run_shape_probe.py --mode infer --num-few-shot 1 \
        --model-id /models/medgemma-1.5-4b-it \
        --few-shot-metadata /results/shape_probe/clinical_easy/shape_metadata.csv \
        --metadata /results/shape_probe/clinical/shape_metadata.csv \
        --out /results/shape_probe/clinical/probe_results_1shot.csv

    # zero-shot vs few-shot in one table (eval breaks down by num_few_shot)
    python shape_probe/run_shape_probe.py --mode eval \
        --results /results/shape_probe/clinical/probe_results.csv \
                  /results/shape_probe/clinical/probe_results_1shot.csv


# --- 4. score --------------------------------------------------------------
    python shape_probe/run_shape_probe.py --mode eval \
        --results /results/shape_probe/mri/probe_results.csv

    # all conditions in one table -- just pass every CSV (eval concatenates them
    # and breaks the accuracy down by `background`)
    python shape_probe/run_shape_probe.py --mode eval \
        --results /results/shape_probe/*/probe_results*.csv


# --- 5. review in the browser (flat: no aggregation, gt is per image) ------
    python shape_probe/review_server.py \
        --results /results/shape_probe/mri/probe_results.csv \
        --port 8547 --host 0.0.0.0

    # all conditions / shards at once
    python shape_probe/review_server.py \
        --results /results/shape_probe/*/probe_results*.csv \
        --port 8547 --host 0.0.0.0
